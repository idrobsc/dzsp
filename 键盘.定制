local function makeShortcutWindow(spec)
    local code = keyCodeFromName(spec.code)
    if not code then
        return
    end
    shortcutCount = shortcutCount + 1
    local vp = getViewport()
    local width, height = 78, 82
    local x = mainFrame.Position.X.Offset + mainFrame.AbsoluteSize.X + 12
    local y = mainFrame.Position.Y.Offset + 12 + ((shortcutCount - 1) % 5) * 10
    if x + width > vp.X - 6 then
        x = math.max(6, mainFrame.Position.X.Offset - width - 12)
    end
    if x + width > vp.X - 6 then
        x = math.max(6, vp.X - width - 6)
    end
    if y + height > vp.Y - 6 then
        y = math.max(6, vp.Y - height - 6)
    end
    local locked = false
    local window = make("Frame", {
        Name = "Shortcut_" .. spec.code .. "_" .. shortcutCount,
        BackgroundColor3 = palette.background,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(width, height),
        Position = UDim2.fromOffset(x, y),
        Active = true,
        ZIndex = 10 + shortcutCount * 10
    }, gui)
    corner(window, 10)
    outline(window, palette.stroke, 0.05, 1)
    local top = make("Frame", {
        BackgroundColor3 = palette.panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 23),
        ZIndex = window.ZIndex + 1
    }, window)
    corner(top, 8)
    make("Frame", {
        BackgroundColor3 = palette.panel,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -7),
        Size = UDim2.new(1, 0, 0, 7),
        ZIndex = top.ZIndex
    }, top)
    local title = make("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(7, 0),
        Size = UDim2.new(1, -36, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = "KEY · " .. spec.text,
        TextColor3 = palette.secondary,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
