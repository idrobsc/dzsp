        lockButton:SetAttribute("Selected", locked)
        lockButton.BackgroundColor3 = locked and palette.locked or palette.key
    end)
    local keyButton = make("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = palette.key,
        BorderSizePixel = 0,
