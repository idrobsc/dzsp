    currentResize = nil
    for input in pairs(activeInputs) do
        endKey(input)
    end
    for keyCode, count in pairs(keyCounts) do
        if count > 0 then
            sendKey(keyCode, false)
        end
    end
    table.clear(activeInputs)
    table.clear(keyCounts)
end)
