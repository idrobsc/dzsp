local function sendKey(keyCode, down)
    if not VirtualInputManager then
        return
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(down, keyCode, false, game)
    end)
end

local function beginKey(input, keyCode)
    if activeInputs[input] then
        return
    end
    activeInputs[input] = keyCode
    local count = keyCounts[keyCode] or 0
    keyCounts[keyCode] = count + 1
    if count == 0 then
        sendKey(keyCode, true)
    end
end

local function endKey(input)
    local keyCode = activeInputs[input]
    if not keyCode then
        return
    end
    activeInputs[input] = nil
    local count = math.max(0, (keyCounts[keyCode] or 1) - 1)
    keyCounts[keyCode] = count
    if count == 0 then
        sendKey(keyCode, false)
    end
end

local function bindKeyButton(button, keyCode)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            beginKey(input, keyCode)
        end
    end)
    button.InputEnded:Connect(endKey)
end

local function make(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(object, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, object)
end

local function outline(object, color, transparency, thickness)
    make("UIStroke", {
        Color = color or palette.stroke,
        Transparency = transparency or 0,
        Thickness = thickness or 1
    }, object)
end

local function makeButton(parent, text, size, position, color, textSize)
    local button = make("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = color or palette.key,
        BorderSizePixel = 0,
        Size = size,
        Position = position,
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = palette.text,
        TextSize = textSize or 13,
        TextScaled = false,
        Active = true,
        Selectable = false
    }, parent)
    corner(button, 7)
    button.MouseEnter:Connect(function()
        if not button:GetAttribute("Selected") then
            button.BackgroundColor3 = palette.keyHover
        end
    end)
    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = button:GetAttribute("Selected") and palette.locked or color or palette.key
    end)
    return button
end

local function getViewport()
    local camera = workspace.CurrentCamera
    if camera then
        return camera.ViewportSize
    end
    return Vector2.new(800, 600)
end

local function bindDrag(zone, frame, lockedFunction)
    zone.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if lockedFunction and lockedFunction() then
            return
        end
        if currentDrag then
            return
        end
        currentDrag = {
            frame = frame,
            input = input,
            startPointer = input.Position,
            startPosition = frame.Position
        }
    end)
end

local function bindResize(frame, grip, minWidth, minHeight, maxWidthFunction, maxHeightFunction)
    grip.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if currentResize then
            return
        end
        currentResize = {
            frame = frame,
            input = input,
            startPointer = input.Position,
            startSize = frame.AbsoluteSize,
            minWidth = minWidth,
            minHeight = minHeight,
            maxWidthFunction = maxWidthFunction,
            maxHeightFunction = maxHeightFunction
        }
    end)
end

UserInputService.InputChanged:Connect(function(input)
    if currentDrag then
        local state = currentDrag
        local matching = (state.input.UserInputType == Enum.UserInputType.Touch and input == state.input)
            or (state.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if matching then
            local delta = input.Position - state.startPointer
            state.frame.Position = UDim2.fromOffset(
                state.startPosition.X.Offset + delta.X,
                state.startPosition.Y.Offset + delta.Y
            )
        end
    end
    if currentResize then
        local state = currentResize
        local matching = (state.input.UserInputType == Enum.UserInputType.Touch and input == state.input)
            or (state.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if matching then
            local delta = input.Position - state.startPointer
            local viewport = getViewport()
            local maxWidth = math.max(state.minWidth, math.min(state.maxWidthFunction(), viewport.X - 10))
            local maxHeight = math.max(state.minHeight, math.min(state.maxHeightFunction(), viewport.Y - 10))
            local width = math.clamp(state.startSize.X + delta.X, state.minWidth, maxWidth)
            local height = math.clamp(state.startSize.Y + delta.Y, state.minHeight, maxHeight)
            state.frame.Size = UDim2.fromOffset(width, height)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    endKey(input)
    if currentDrag and (input == currentDrag.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
        currentDrag = nil
    end
    if currentResize and (input == currentResize.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
        currentResize = nil
    end
end)

local function addResizeGrip(frame, minWidth, minHeight, maxWidthFunction, maxHeightFunction, zIndex)
    local grip = make("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = palette.accent,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(15, 15),
        Position = UDim2.new(1, -15, 1, -15),
        Text = "◢",
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = palette.text,
        ZIndex = zIndex or 5
    }, frame)
    corner(grip, 4)
    bindResize(frame, grip, minWidth, minHeight, maxWidthFunction, maxHeightFunction)
    return grip
end

local function keyCodeFromName(name)
    local ok, keyCode = pcall(function()
        return Enum.KeyCode[name]
    end)
    if ok then
        return keyCode
    end
    return nil
end

local function keyDef(text, code, weight)
    return {text = text, code = code, weight = weight or 1}
